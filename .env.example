# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Optional; not needed for long-polling
# TELEGRAM_BOT_USERNAME=

# PostgreSQL credentials (used by docker compose and wired into the app as SPRING_DATASOURCE_*)
POSTGRES_DB=gdebenz
POSTGRES_USER=gdebenz
POSTGRES_PASSWORD=change-me-locally
